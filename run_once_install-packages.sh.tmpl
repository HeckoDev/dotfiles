#!/bin/bash

set -e  # Exit on error

echo "🚀 Installation de l'environnement de développement..."

# Couleurs pour les messages
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Fonction pour afficher les messages
log_info() {
    echo -e "${GREEN}✓${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1"
}

# Détection de l'OS
OS="unknown"
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    OS="linux"
elif [[ "$OSTYPE" == "darwin"* ]]; then
    OS="macos"
fi

log_info "Système détecté: $OS"

# ==================== HOMEBREW ====================
log_info "Installation de Homebrew..."
if ! command -v brew &> /dev/null; then
    if [[ "$OS" == "linux" ]]; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [[ "$OS" == "macos" ]]; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
else
    log_info "Homebrew déjà installé"
fi

# Mise à jour Homebrew
brew update

# ==================== PACKAGES SYSTÈME ====================
log_info "Installation des packages système via Homebrew..."

# Outils de base
PACKAGES=(
    # Shell & Terminal
    "zsh"
    "fzf"
    
    # Éditeurs
    "vim"           # Éditeur de texte classique
    "neovim"        # Éditeur moderne
    
    # Outils modernes CLI
    "eza"           # ls moderne
    "bat"           # cat avec syntax highlighting
    "delta"         # diff viewer pour git
    "ripgrep"       # grep rapide
    "fd"            # find moderne
    "zoxide"        # cd intelligent (alternative à z)
    
    # Git
    "git"
    "git-delta"
    
    # Développement
    "go"
    "node"
    "python3"
    
    # Utilitaires
    "curl"
    "wget"
    "jq"            # JSON processor
    "htop"
    "tmux"
    
    # Autres
    "autojump"
)

for package in "${PACKAGES[@]}"; do
    if brew list "$package" &> /dev/null; then
        log_info "$package déjà installé"
    else
        log_info "Installation de $package..."
        brew install "$package" || log_warn "Échec de l'installation de $package"
    fi
done

# ==================== OH-MY-ZSH ====================
log_info "Installation de Oh-My-Zsh..."
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    log_info "Oh-My-Zsh installé"
else
    log_info "Oh-My-Zsh déjà installé"
fi

# ==================== ZSH PLUGINS ====================
log_info "Installation des plugins Zsh..."

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# zsh-autosuggestions
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
    log_info "zsh-autosuggestions installé"
else
    log_info "zsh-autosuggestions déjà installé"
fi

# zsh-syntax-highlighting
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
    log_info "zsh-syntax-highlighting installé"
else
    log_info "zsh-syntax-highlighting déjà installé"
fi

# zsh-completions
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-completions" ]; then
    git clone https://github.com/zsh-users/zsh-completions "$ZSH_CUSTOM/plugins/zsh-completions"
    log_info "zsh-completions installé"
else
    log_info "zsh-completions déjà installé"
fi

# zsh-history-substring-search
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-history-substring-search" ]; then
    git clone https://github.com/zsh-users/zsh-history-substring-search "$ZSH_CUSTOM/plugins/zsh-history-substring-search"
    log_info "zsh-history-substring-search installé"
else
    log_info "zsh-history-substring-search déjà installé"
fi

# ==================== POWERLEVEL10K ====================
log_info "Installation de Powerlevel10k..."
if [ ! -d "$ZSH_CUSTOM/themes/powerlevel10k" ]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k"
    log_info "Powerlevel10k installé"
else
    log_info "Powerlevel10k déjà installé"
fi

# ==================== SDKMAN ====================
log_info "Installation de SDKMAN..."
if [ ! -d "$HOME/.sdkman" ]; then
    curl -s "https://get.sdkman.io" | bash
    log_info "SDKMAN installé"
else
    log_info "SDKMAN déjà installé"
fi

# ==================== ASDF (Version Manager) ====================
log_info "Installation de asdf..."
if [ ! -d "$HOME/.asdf" ]; then
    git clone https://github.com/asdf-vm/asdf.git ~/.asdf --branch v0.14.0
    log_info "asdf installé"
else
    log_info "asdf déjà installé"
fi

# ==================== ATUIN (Shell History) ====================
log_info "Installation de Atuin..."
if ! command -v atuin &> /dev/null; then
    bash <(curl --proto '=https' --tlsv1.2 -sSf https://setup.atuin.sh)
    log_info "Atuin installé"
else
    log_info "Atuin déjà installé"
fi

# ==================== ANGULAR CLI ====================
if command -v npm &> /dev/null; then
    log_info "Installation de Angular CLI..."
    if ! command -v ng &> /dev/null; then
        npm install -g @angular/cli
        log_info "Angular CLI installé"
    else
        log_info "Angular CLI déjà installé"
    fi
fi

# ==================== GO TOOLS ====================
log_info "Installation des outils Go..."
if command -v go &> /dev/null; then
    GO_TOOLS=(
        "github.com/go-delve/delve/cmd/dlv@latest"
        "golang.org/x/tools/cmd/gopls@latest"
        "honnef.co/go/tools/cmd/staticcheck@latest"
    )
    
    for tool in "${GO_TOOLS[@]}"; do
        log_info "Installation de $tool..."
        go install "$tool" || log_warn "Échec de l'installation de $tool"
    done
fi

# ==================== CRÉATION DES RÉPERTOIRES ====================
log_info "Création des répertoires..."
mkdir -p "$HOME/bin"
mkdir -p "$HOME/go/bin"
mkdir -p "$HOME/projects"
mkdir -p "$HOME/my_projects"
mkdir -p "$HOME/.local/bin"

# ==================== ZSH PAR DÉFAUT ====================
log_info "Configuration de Zsh comme shell par défaut..."
if [ "$SHELL" != "$(which zsh)" ]; then
    log_warn "Changement du shell par défaut vers Zsh..."
    chsh -s "$(which zsh)" || log_warn "Impossible de changer le shell. Exécutez: chsh -s \$(which zsh)"
else
    log_info "Zsh est déjà le shell par défaut"
fi

# ==================== FINALISATION ====================
echo ""
log_info "✨ Installation terminée !"
echo ""
echo "📝 Prochaines étapes :"
echo "   1. Redémarrez votre terminal ou exécutez: exec zsh"
echo "   2. Si vous êtes sur une machine de travail, créez: ~/.oh-my-zsh/custom/work.zsh"
echo "   3. Configurez Powerlevel10k si nécessaire: p10k configure"
echo ""

{{- if eq .chezmoi.os "linux" }}
# Configuration spécifique Linux
log_info "Configuration Linux détectée"
{{- else if eq .chezmoi.os "darwin" }}
# Configuration spécifique macOS
log_info "Configuration macOS détectée"
{{- end }}
